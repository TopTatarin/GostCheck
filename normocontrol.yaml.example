version: 1
# Профиль задаёт пользователь; auto/LLM-выбор намеренно не поддерживается.
work_profile: software
rubric_path: rubric.yaml
output_dir: build/normocontrol
approved_params:
  - font_size_pt
  - fig_numbering
  - defense_year
  - recent_sources_share
params:
  font_size_pt: 14
  fig_numbering: "сквозная"
  defense_year: 2026
  recent_sources_share: 0.5
llm:
  # disabled | ollama | имя облачного провайдера
  provider: disabled
  model: qwen3:8b-q4_K_M
  base_url: http://localhost:11434/v1
  allow_cloud_data: false
  # Секреты хранятся только в переменных окружения, например OPENAI_API_KEY.
  # API-ключи нельзя добавлять в этот файл.
